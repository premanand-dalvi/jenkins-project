pipeline {
  agent any
   stages {
      stage('Pull code from github') {
         steps {
                 echo 'pulling code from github repo...'
                 git branch: 'master', url: 'https://github.com/premanand-dalvi/jenkins-project.git'
                 echo 'code pulled seccess'
         }

      }
      stage('build Backend') {
           steps {
              dir('backend') {
                   sh 'mvn clean package -DskipTests'

              }
           }
      }


   }
}
